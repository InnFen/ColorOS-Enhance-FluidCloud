<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:importantForAutofill="noExcludeDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sim_slot_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:accessibilityHeading="true"
            android:textAppearance="@style/sim_TextAppearance_SimPin_Section" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sim_toggle_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:enabled="false"
            android:saveEnabled="false" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/sim_slot_toggle_hint"
        android:textAppearance="@style/sim_TextAppearance_SimPin_Body" />

    <TextView
        android:id="@+id/sim_slot_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="4dp"
        android:accessibilityLiveRegion="polite"
        android:text="@string/sim_status_loading"
        android:textAppearance="@style/sim_TextAppearance_SimPin_Body" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/sim_Widget_SimPin_PinInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="@string/sim_hint_pin"
        app:helperText="@string/sim_pin_format_hint"
        android:saveEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/sim_pin_entry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789"
            android:importantForAutofill="no"
            android:inputType="numberPassword"
            android:imeOptions="actionNext|flagNoPersonalizedLearning"
            android:maxLines="1"
            android:maxLength="8"
            android:saveEnabled="false" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/sim_Widget_SimPin_PinInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/sim_hint_pin_confirmation"
        android:saveEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/sim_pin_confirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789"
            android:importantForAutofill="no"
            android:inputType="numberPassword"
            android:imeOptions="actionDone|flagNoPersonalizedLearning"
            android:maxLines="1"
            android:maxLength="8"
            android:saveEnabled="false" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sim_save_button"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="48dp"
        android:text="@string/sim_action_save_enable" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sim_clear_button"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:minHeight="48dp"
        android:enabled="false"
        android:text="@string/sim_action_clear_slot" />
</LinearLayout>
